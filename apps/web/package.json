{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "20.18.0"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build && npm run copy-standalone-assets",
    "copy-standalone-assets": "node -e \"const fs=require('fs'); fs.cpSync('.next/static', '.next/standalone/apps/web/.next/static', {recursive:true,force:true}); try{fs.cpSync('public', '.next/standalone/apps/web/public', {recursive:true,force:true})}catch(e){}\"",
    "start": "node ../../scripts/start-next-app.mjs web",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "lighthouse": "lhci autorun",
    "test": "echo \"No web unit tests configured\" && exit 0"
  },
  "dependencies": {
    "@repo/api-config": "*",
    "@repo/ui": "*",
    "@tanstack/react-query": "^5.100.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.2"
  }
}
