# Database
DATABASE_URL="postgresql://sharpwork:sharpwork123@localhost:5433/sharpwork?schema=public"

# Redis (OTP cache, artisan availability, rate limits, refresh denylist)
REDIS_URL="redis://localhost:6379"

# Auth (optional — auto-derived from Railway project ID when unset)
# JWT_ACCESS_SECRET="change-me-access"
# JWT_REFRESH_SECRET="change-me-refresh"

# Server
PORT=4000
NODE_ENV=development
# Optional overrides; web/admin use same-origin /backend proxy in production
# WEB_APP_URL="http://localhost:3002"
# API_PUBLIC_URL="http://localhost:4000"

# Email (SendGrid)
# SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL="noreply@sharpwork.com"

# SMS (Termii) — password reset OTP; dev mode logs codes to console
# TERMII_API_KEY=
TERMII_SENDER_ID="SharpWork"
TERMII_BASE_URL="https://api.ng.termii.com/api"

# Paystack — escrow hold, transfer on completion, refund on disputes
# PAYSTACK_SECRET_KEY=
PLATFORM_FEE_PERCENT=15

# Smile Identity — NIN/BVN verification and liveness (sandbox by default)
# SMILE_PARTNER_ID=
# SMILE_API_KEY=
SMILE_ENV=sandbox

# AWS S3 + CloudFront — artisan portfolio/ID uploads (local ./uploads in dev)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=af-south-1
# AWS_S3_BUCKET=
# AWS_CLOUDFRONT_URL=

# Observability (optional)
# SENTRY_DSN=
