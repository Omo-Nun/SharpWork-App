# Production environment template — copy to .env.production and fill in values

# Database (AWS RDS PostgreSQL 15 + PostGIS in af-south-1)
DATABASE_URL="postgresql://USER:PASSWORD@your-rds-host:5432/sharpwork?schema=public"

# Redis (ElastiCache)
# Optional — omit on Railway unless you add a Redis service.
# REDIS_URL="redis://your-redis-host:6379"

# Auth — use strong random secrets in production
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Public URLs
WEB_APP_URL="https://sharpwork.com"
API_PUBLIC_URL="https://api.sharpwork.com"
NEXT_PUBLIC_API_URL="https://api.sharpwork.com"
NEXT_PUBLIC_WEB_URL="https://sharpwork.com"

# Paystack (live keys)
PAYSTACK_SECRET_KEY="pk_test_1fb38f77ee7ef7694d5582d0b5e1502cdd56346f"
PLATFORM_FEE_PERCENT=15

