{
  "name": "SharpWork App",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:integration": "npm run test:integration --workspace=api",
    "lighthouse": "npm run lighthouse --workspace=web",
    "deploy:checklist": "bash scripts/production-checklist.sh",
    "deploy:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:admin": "npm run build --workspace=admin",
    "start:api": "npm run start:prod --workspace=api",
    "start:web": "npm run start --workspace=web",
    "start:admin": "npm run start --workspace=admin"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "20.18.0"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
